    "i-ch-lead": {
      "id": "i-ch-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The helpers stay small because the agent and its runners do the work."
        }
      ],
      "children": []
    },
    "i-ch1": {
      "id": "i-ch1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Markdown keeps the objective readable with ordinary repository tools."
        }
      ],
      "children": []
    },
    "i-ch2": {
      "id": "i-ch2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Pseudo-XML marks sections without a runtime parser."
        }
      ],
      "children": []
    },
    "i-ch3": {
      "id": "i-ch3",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
