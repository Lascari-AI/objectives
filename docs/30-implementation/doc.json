    "i-open": {
      "id": "i-open",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The skill's two Python helpers create an objective bundle and check goal length. They use only the Python standard library. They do not run the objective, schedule work, or manage checkpoints."
        }
      ],
      "children": []
    },
    "i-ctx": {
      "id": "i-ctx",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Both helpers support the "
        },
        {
          "insert": "Objective Bundle and Lifecycle",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design"
            }
          }
        },
        {
          "insert": " contract, and their source is under "
        },
        {
          "insert": ".codex/skills/setup-objective/scripts/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "i-h-scaf": {
      "id": "i-h-scaf",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Scaffold"
        }
      ],
      "children": []
    },
    "i-sc-lead": {
      "id": "i-sc-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": ".codex/skills/setup-objective/scripts/create_objective.py",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": ".codex/skills/setup-objective/scripts/create_objective.py"
            }
          }
        },
        {
          "insert": " writes the README, goal, current state, and five context templates."
        }
      ],
      "children": []
    },
    "i-sc1": {
      "id": "i-sc1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "It normalizes the name to a lowercase hyphenated slug."
        }
      ],
      "children": []
    },
    "i-sc2": {
      "id": "i-sc2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "It creates "
        },
        {
          "insert": "examples/.gitkeep",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " unless you pass "
        },
        {
          "insert": "--no-examples",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "30-implementation-5": {
      "id": "30-implementation-5",
      "type": "structured-table",
      "props": {
        "columns": [
          "Argument",
          "Behavior"
        ],
        "rows": [
          [
            "name",
            "Required objective name or slug."
          ],
          [
            "--title TEXT",
            "Readable title; otherwise derived from the slug."
          ],
          [
            "--root PATH",
            "Output root; defaults to objectives relative to the current directory."
          ],
          [
            "--no-examples",
            "Skip examples/.gitkeep."
          ],
          [
            "--date TEXT",
            "Initial state date; defaults to today's date. Use YYYY-MM-DD."
          ],
          [
            "--force",
            "Overwrite existing scaffold files. This replaces content, so inspect the destination first."
          ]
        ]
      },
      "children": []
    },
    "i-sc3": {
      "id": "i-sc3",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The overwrite check runs per file, not across the whole bundle."
        }
      ],
      "children": [
        "i-sc3a",
        "i-sc3b"
      ]
    },
    "i-sc3a": {
      "id": "i-sc3a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The script can write earlier files before a later existing file stops it."
        }
      ],
      "children": []
    },
    "i-sc3b": {
      "id": "i-sc3b",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "After a failure, inspect the directory instead of rerunning with "
        },
        {
          "insert": "--force",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "i-sc4": {
      "id": "i-sc4",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The templates are deliberately incomplete."
        }
      ],
      "children": [
        "i-sc4a"
      ]
    },
    "i-sc4a": {
      "id": "i-sc4a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A successful run means the files exist, not that the objective is ready to execute."
        }
      ],
      "children": []
    },
    "i-h-val": {
      "id": "i-h-val",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Goal-Length Validator"
        }
      ],
      "children": []
    },
    "i-v-lead": {
      "id": "i-v-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": ".codex/skills/setup-objective/scripts/validate_goal_length.py",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": ".codex/skills/setup-objective/scripts/validate_goal_length.py"
            }
          }
        },
        {
          "insert": " checks that a goal fits under the 4,000-character Codex "
        },
        {
          "insert": "/goal",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " limit."
        }
      ],
      "children": []
    },
    "i-v1": {
      "id": "i-v1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "It reads a file, or stdin when no path is given."
        }
      ],
      "children": []
    },
    "i-v2": {
      "id": "i-v2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Before counting, it strips surrounding whitespace, an outer fenced block, and a leading "
        },
        {
          "insert": "/goal",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " command followed by whitespace."
        }
      ],
      "children": []
    },
    "30-implementation-10": {
      "id": "30-implementation-10",
      "type": "structured-table",
      "props": {
        "columns": [
          "Argument",
          "Behavior"
        ],
        "rows": [
          [
            "path",
            "Optional file. When omitted, read stdin."
          ],
          [
            "--max-chars N",
            "Hard maximum; default 3,999."
          ],
          [
            "--target-chars N",
            "Optional advisory target; no target by default."
          ],
          [
            "--compact-target",
            "Use the 1,600-character advisory target unless an explicit target is set."
          ],
          [
            "--strict-target",
            "Fail above the selected target; default target becomes 1,600 if none was chosen."
          ]
        ]
      },
      "children": []
    },
    "i-v3": {
      "id": "i-v3",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "It prints "
        },
        {
          "insert": "objective_chars",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "target_chars",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "max_chars",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "i-v4": {
      "id": "i-v4",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "It exits with code 1 above the hard maximum of 3,999 characters, or above a target enforced with "
        },
        {
          "insert": "--strict-target",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": [
        "i-v4a"
      ]
    },
    "i-v4a": {
      "id": "i-v4a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "An advisory target warning alone still exits with code 0."
        }
      ],
      "children": []
    },
    "i-v5": {
      "id": "i-v5",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "An empty goal passes the length check, so review the goal's meaning as well."
        }
      ],
      "children": []
    },
    "i-v6": {
      "id": "i-v6",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The default maximum is the Codex TUI limit recorded by the skill. Other clients and hosts may set different limits."
        }
      ],
      "children": []
    },
    "i-h-ch": {
      "id": "i-h-ch",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Implementation Choices"
