    "i-ch3a": {
      "id": "i-ch3a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A documented flag such as "
        },
        {
          "insert": "--resume",
          "attributes": {
            "code": true
          }
