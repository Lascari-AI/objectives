    "f-open": {
      "id": "f-open",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Objectives are a lightweight framework that keeps a coding agent on track during long-running tasks. All you need is a prompt and a file structure, with no service, no scheduler, and nothing to deploy. The setup-objective skill writes the files, and the agent rereads them after every compaction."
        }
      ],
      "children": []
    },
    "f-origin": {
      "id": "f-origin",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The pattern came out of an image-grouping coding challenge, where a plain goal-mode run beat a custom multi-agent research harness with far less setup."
        }
      ],
      "children": []
    },
    "f-h-constraint": {
      "id": "f-h-constraint",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "The Constraint"
        }
      ],
      "children": []
    },
    "f-c-lead": {
      "id": "f-c-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Goal mode keeps one static goal prompt in context through every compaction."
        }
      ],
      "children": []
    },
    "f-c1": {
      "id": "f-c1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The goal prompt is capped under 4,000 characters."
        }
      ],
      "children": []
    },
    "f-c2": {
      "id": "f-c2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Everything else gets summarized at each compaction."
        }
      ],
      "children": [
        "f-c2a",
        "f-c2b"
      ]
    },
    "f-c2a": {
      "id": "f-c2a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Run details, results, and decisions lose detail every time."
        }
      ],
      "children": []
    },
    "f-c2b": {
      "id": "f-c2b",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "On a run that lasts days, you cannot trust the summary to keep what matters."
        }
      ],
      "children": []
    },
    "f-c3": {
      "id": "f-c3",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A long run needs far more context than 4,000 characters can hold."
        }
      ],
      "children": [
        "f-c3a",
        "f-c3b",
        "f-c3c",
        "f-c3d"
      ]
    },
    "f-c3a": {
      "id": "f-c3a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "It needs explicit stopping criteria."
        }
      ],
      "children": []
    },
    "f-c3b": {
      "id": "f-c3b",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "It needs to know how the work should be done, such as running experiments with MLX."
        }
      ],
      "children": []
    },
    "f-c3c": {
      "id": "f-c3c",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "It needs a record of every experiment."
        }
      ],
      "children": []
    },
    "f-c3d": {
      "id": "f-c3d",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "It needs to know where the run is right now."
        }
      ],
      "children": []
    },
    "f-h-goal": {
      "id": "f-h-goal",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "The Goal Prompt"
        }
      ],
      "children": []
    },
    "f-g-lead": {
      "id": "f-g-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The goal prompt stays short and points to files. Every objective's "
        },
        {
          "insert": "goal.md",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " has the same six blocks."
        }
      ],
      "children": []
    },
    "f-g-code": {
      "id": "f-g-code",
      "type": "code",
      "props": {
        "language": "xml"
      },
      "text": [
        {
          "insert": "<goal>\n- What this objective must achieve.\n</goal>\n\n<context_refresh>\n- Reread objectives/<slug>/goal.md.\n- Reread objectives/<slug>/current_state.md.\n- Reread the relevant objectives/<slug>/context/*.md files.\n</context_refresh>\n\n<working_strategy>\n- The approach and the order of work.\n</working_strategy>\n\n<success_metrics>\n- Observable signs of progress.\n</success_metrics>\n\n<non_goals>\n- What this objective must not expand into.\n</non_goals>\n\n<completion_criteria>\n- What must be true before the objective is done.\n</completion_criteria>"
        }
      ],
      "children": []
    },
    "f-g1": {
      "id": "f-g1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The "
        },
        {
          "insert": "<context_refresh>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " block does the main work."
        }
      ],
      "children": [
        "f-g1a",
        "f-g1b"
      ]
    },
    "f-g1a": {
      "id": "f-g1a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "It tells the agent to reread the objective's files at the start and after every compaction."
        }
      ],
      "children": []
    },
    "f-g1b": {
      "id": "f-g1b",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The files carry the context that does not fit in the goal."
        }
      ],
      "children": []
    },
    "f-g2": {
      "id": "f-g2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The other blocks state the outcome, the approach, the progress signals, the scope limits, and when the objective is done."
        }
      ],
      "children": []
    },
    "f-h-homes": {
      "id": "f-h-homes",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Where Each Need Lives"
        }
      ],
      "children": []
    },
    "f-hm-lead": {
      "id": "f-hm-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each need of a long run has its own home in the objective."
        }
      ],
      "children": []
    },
    "f-hm1": {
      "id": "f-hm1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Stopping criteria live in goal.md.",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "f-hm1a",
        "f-hm1b"
      ]
    },
    "f-hm1a": {
      "id": "f-hm1a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Name every metric on every dataset so the agent knows exactly when it is done."
        }
      ],
      "children": []
    },
    "f-hm1b": {
      "id": "f-hm1b",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "\"Get the accuracy higher\" lets the agent stop after one dataset improves."
        }
      ],
      "children": []
    },
    "f-hm2": {
      "id": "f-hm2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "How the agent should work lives in context/.",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "f-hm2a",
        "f-hm2b"
      ]
    },
    "f-hm2a": {
      "id": "f-hm2a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The context files hold the plan, the constraints, and project how-tos, such as running experiments with MLX."
        }
      ],
      "children": []
    },
    "f-hm2b": {
      "id": "f-hm2b",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "They have no length limit."
        }
      ],
      "children": []
    },
    "f-hm3": {
      "id": "f-hm3",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Every experiment lives in the objective's workspace.",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "f-hm3a",
        "f-hm3b"
      ]
    },
    "f-hm3a": {
      "id": "f-hm3a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Scripts, reports, and run outputs stay inside "
        },
        {
          "insert": "objectives/<slug>/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "f-hm3b": {
      "id": "f-hm3b",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The repo stays clean, and every file traces back to the objective that made it."
        }
      ],
      "children": []
    },
    "f-hm4": {
      "id": "f-hm4",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The current state lives in current_state.md.",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "f-hm4a",
        "f-hm4b"
      ]
    },
    "f-hm4a": {
      "id": "f-hm4a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "It records what is proven, what is running, and what comes next."
        }
      ],
      "children": []
    },
    "f-hm4b": {
      "id": "f-hm4b",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A restarted agent resumes from it, and you read the same file to check on a run."
        }
      ],
      "children": []
    },
