    "f-h-pc": {
      "id": "f-h-pc",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Pros and Cons"
        }
      ],
      "children": []
    },
    "f-pc-lead": {
      "id": "f-pc-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Objectives are the fast way to get one long task running. They do not replace a full orchestration system."
        }
      ],
      "children": []
    },
    "f-pro": {
      "id": "f-pro",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Pros",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "f-pro1",
        "f-pro2",
        "f-pro3"
      ]
    },
    "f-pro1": {
      "id": "f-pro1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Setup takes a prompt and a few files, with no service to build."
        }
      ],
      "children": []
    },
    "f-pro2": {
      "id": "f-pro2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The format is built for long runs. The agent stays on track across compactions and restarts."
        }
      ],
      "children": []
    },
    "f-pro3": {
      "id": "f-pro3",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The pattern is general. It fits most tasks you can describe with clear stopping criteria."
        }
      ],
      "children": []
    },
    "f-con": {
      "id": "f-con",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Cons",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "f-con1",
        "f-con2"
      ]
    },
    "f-con1": {
      "id": "f-con1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The run is not optimized. You cannot tune individual agents to cut cost or improve efficiency."
        }
      ],
      "children": []
    },
    "f-con2": {
      "id": "f-con2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "One agent follows one path. There is no fan-out to parallel candidates or separate research agents."
        }
      ],
      "children": []
    },
    "f-pc-close": {
      "id": "f-pc-close",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A fully built orchestration system would likely do better, but it takes far more time to build and tune."
        }
      ],
      "children": []
    },
